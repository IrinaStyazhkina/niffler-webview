<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_margin="8dp">
    <com.google.android.material.chip.Chip
        android:id="@+id/categoryName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="60dp"
        tools:text="Sports"
        app:chipCornerRadius="36dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:padding="8dp"
        android:textSize="16sp"
        />
    <Button
        style="@style/Widget.AppTheme.Niffler.SurfaceIconButton"
        android:id="@+id/buttonEdit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/edit_category"
        app:layout_constraintEnd_toStartOf="@id/buttonArchive"
        app:layout_constraintTop_toTopOf="@id/categoryName"
        app:layout_constraintBottom_toBottomOf="@id/categoryName"
        app:icon="@drawable/ic_edit"
        />
    <Button
        style="@style/Widget.AppTheme.Niffler.SurfaceIconButton"
        android:id="@+id/buttonArchive"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/archive_category"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/categoryName"
        app:layout_constraintBottom_toBottomOf="@id/categoryName"
        app:icon="@drawable/ic_archive"
        />

</androidx.constraintlayout.widget.ConstraintLayout>