<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/spendings">
    <TextView
        android:id="@+id/tvSpendingsHeader"
        android:theme="@style/Base.Theme.NifferAndroid.HeaderTextAppearance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/history_of_spendings"
        android:textSize="36sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/spendings" />
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/searchBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:endIconMode="custom"
        app:endIconDrawable="@drawable/ic_search"
        app:endIconTint="@color/light_primary"
        app:layout_constraintTop_toBottomOf="@id/tvSpendingsHeader"
        app:layout_constraintStart_toStartOf="parent"
        >
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/searchBar"
            android:inputType="text"
            android:hint="@string/search"
            android:backgroundTint="@color/gray_50"
            android:backgroundTintMode="add"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/periodSelectLayout"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@+id/searchBarLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/currencySelectLayout"
        >
        <AutoCompleteTextView
            android:id="@+id/periodSelect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"
            android:text="All time"
            android:backgroundTint="@color/gray_50"
            android:backgroundTintMode="add"
            />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/currencySelectLayout"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="126dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toStartOf="@id/deleteItemsButton"
        app:layout_constraintStart_toEndOf="@id/periodSelectLayout"
        app:layout_constraintTop_toBottomOf="@id/searchBarLayout"
        >
        <AutoCompleteTextView
            android:id="@+id/currencySelect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"
            android:text="Р"
            android:backgroundTint="@color/gray_50"
            android:backgroundTintMode="add"
            />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/deleteItemsButton"
        app:layout_constraintTop_toTopOf="@+id/currencySelectLayout"
        app:layout_constraintBottom_toBottomOf="@+id/currencySelectLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:icon="@drawable/ic_delete"
        app:iconTint="@color/red"
        android:padding="12dp"
        style="@style/Widget.AppTheme.Niffler.SecondaryIconButton"
        />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/spendingsList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/periodSelectLayout"
        android:layout_marginTop="12dp"
        android:nestedScrollingEnabled="true"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        android:overScrollMode="never"
        tools:listitem="@layout/spending_item"
        />
</androidx.constraintlayout.widget.ConstraintLayout>