<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    >
    <CheckBox
        android:id="@+id/spendingCheckbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvSpendingCategory"
        app:layout_constraintTop_toBottomOf="@+id/tvSpendingDescription"
        />
    <TextView
        android:id="@+id/tvSpendingCategory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@+id/spendingCheckbox"
        tools:text="Restaurants"
        android:maxLines="1"
        android:ellipsize="end"
        android:lines="1"
        android:maxWidth="180dp"
        android:scrollHorizontally="false"
        android:textSize="16sp"
        android:layout_marginStart="6dp"
        />
    <TextView
        android:id="@+id/tvSpendingDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/gray_600"
        app:layout_constraintStart_toEndOf="@+id/spendingCheckbox"
        app:layout_constraintTop_toBottomOf="@id/tvSpendingCategory"
        android:maxLines="2"
        android:ellipsize="end"
        android:lines="2"
        android:scrollHorizontally="false"
        android:maxWidth="180dp"
        tools:text="Dinner"
        android:layout_marginStart="6dp"
        android:textSize="16sp"
        />
    <TextView
        android:id="@+id/tvSpendingPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@id/tvSpendingCategory"
        app:layout_constraintEnd_toStartOf="@id/buttonEdit"
        tools:text="900 Р"
        android:textSize="16sp"
        />
    <TextView
        android:id="@+id/tvSpendingDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/tvSpendingPrice"
        app:layout_constraintEnd_toStartOf="@id/buttonEdit"
        tools:text="19 Mar 2024"
        android:textColor="@color/gray_600"
        android:textSize="16sp"
        />
    <Button
        style="@style/Widget.AppTheme.Niffler.SurfaceIconButton"
        android:id="@+id/buttonEdit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/edit_category"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvSpendingCategory"
        app:icon="@drawable/ic_edit"
        android:layout_marginStart="12dp"
        />

</androidx.constraintlayout.widget.ConstraintLayout>